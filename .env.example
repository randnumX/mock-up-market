# ===== Backend =====
MONGO_URI=mongodb://localhost:27017
DB_NAME=AlgoTradingSource
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_SECRET_KEY=change-this-in-production
CORS_ORIGINS=http://localhost:5173

# ===== Zerodha Kite Connect (optional - real market data) =====
# Get these from https://developers.kite.trade after creating an app.
# Without these set, the app runs fine on MongoDB / synthetic data only.
# KITE_ALLOW is the master kill-switch for all real Kite usage (REST calls,
# the WebSocket ticker) - set to false to force the app onto Mongo/synthetic
# data even if API keys are present.
KITE_ALLOW=false
KITE_API_KEY=
KITE_API_SECRET=
# Must match the "Redirect URL" configured on your Kite Connect app
KITE_REDIRECT_URL=http://localhost:5000/api/kite/callback
# Where the browser lands after a successful/failed Kite login
KITE_FRONTEND_URL=http://localhost:5173

# ===== Live Trading (optional) =====
# How often (seconds) the live engine ticks every running session
LIVE_POLL_INTERVAL_SECONDS=30
# Set true to let paper sessions tick outside NSE market hours (demo/testing only)
LIVE_IGNORE_MARKET_HOURS=false

# ===== Frontend =====
VITE_API_URL=http://localhost:5000
